<mxfile host="65bd71144e">
    <diagram name="Conceptual - Conversation" id="conv">
        <mxGraphModel dx="1683" dy="1535" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="12" value="the_harness" parent="0"/>
                <mxCell id="13" value="The Harness manages this conversation&lt;br&gt;so that the Model appears to work in the&lt;div&gt;given context&lt;br&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font&gt;Harness keeps the book. Model reads, answers and forgets.&lt;br&gt;To A the final reply looks like a conversation.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;align=center;verticalAlign=bottom;fillColor=none;strokeWidth=2;arcSize=8;" vertex="1" parent="12">
                    <mxGeometry x="390" y="210" width="690" height="620" as="geometry"/>
                </mxCell>
                <mxCell id="1" value="Diagram" parent="0"/>
                <mxCell id="title" value="Why the Harness?&lt;div&gt;To manage the asimerical conversation&lt;/div&gt;&lt;div&gt;human to model and back&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="530" y="90" width="480" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Everything a harness does follows from the asymmetry below" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="470" y="170" width="540" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="A-can" value="&lt;b&gt;CAN&lt;/b&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;hold the conversation&lt;/li&gt;&lt;li&gt;decide what to ask next&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;b&gt;CANNOT&lt;/b&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;answer its own question&lt;/li&gt;&lt;/ul&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=12;spacingTop=4;verticalAlign=top;fillColor=none;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="120" y="560" width="200" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="B-name" value="&lt;font style=&quot;font-size: 23px;&quot;&gt;B &lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;The Model&lt;br&gt;answers anything&lt;br&gt;and forgets everything&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1200" y="510" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="B-can" value="&lt;b&gt;CAN&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;read a text and reply to it&lt;/span&gt;&lt;/li&gt;&lt;li&gt;reply about almost anything&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;b&gt;CANNOT&lt;/b&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;remember the previous reply&lt;/li&gt;&lt;li&gt;act in the world&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=12;spacingTop=4;verticalAlign=top;fillColor=none;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="1230" y="600" width="200" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="send" value="All&amp;nbsp;&lt;div&gt;inputs&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;fontSize=22;strokeWidth=12;verticalAlign=bottom;strokeColor=#B4B4B4;dashed=1;dashPattern=1 1;curved=1;" edge="1" parent="1" target="14">
