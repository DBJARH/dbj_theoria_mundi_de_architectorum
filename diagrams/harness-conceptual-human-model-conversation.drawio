                <mxCell id="asym" value="The Assimterical Conversation&lt;br&gt;A remembers but cannot answer&lt;br&gt;B answers but cannot remember" style="rounded=0;whiteSpace=wrap;html=1;fontSize=23;align=center;verticalAlign=bottom;fillColor=none;dashed=1;" vertex="1" parent="1">
