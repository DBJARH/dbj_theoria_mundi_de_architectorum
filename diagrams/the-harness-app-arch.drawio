                    </mxGeometry>
                </mxCell>
                <mxCell id="e-remote-up" value="request text / reply text" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;startArrow=classic;startFill=1;" edge="1" parent="1" source="model" target="endpoint">
                    <mxGeometry x="0.3333" relative="1" as="geometry">
                        <mxPoint as="offset"/>
