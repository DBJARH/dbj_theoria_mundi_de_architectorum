                <mxCell id="e3" value="read" style="edgeStyle=orthogonalEdgeStyle;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="memory" target="assembler" edge="1">
                    <mxGeometry x="-0.6098" y="5" relative="1" as="geometry">
