                </mxCell>
                <mxCell id="e-model-parser" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="model" target="parser">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e-parser-decide" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="parser" target="decide">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" value="results back into&amp;nbsp;&lt;div&gt;assembling&amp;nbsp;&lt;/div&gt;&lt;div&gt;the next context&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.166;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;exitPerimeter=0;" parent="1" source="loop" target="assembler" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e-no" value="no — exit loop, reply is the answer" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="decide" target="behavior">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="caption" value="Claude Code CLI app is the Harness — not the Model — orchestrating tools,&lt;br&gt;memory, and guardrails to create the agentic experience." style="text;html=1;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="834" y="1226" width="540" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="4" style="edgeStyle=none;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#FF3333;" edge="1" parent="1" source="3" target="prompt">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="type / say / paste" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="4">
                    <mxGeometry x="-0.1241" y="-2" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="3" value="HUMAN USER" style="shape=actor;whiteSpace=wrap;html=1;verticalAlign=bottom;strokeColor=#FF3333;strokeWidth=3;" vertex="1" parent="1">
                    <mxGeometry x="515" y="210" width="70" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="ALLOWED" style="edgeStyle=none;html=1;entryX=0.52;entryY=0.014;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="guardrails" target="loop">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="dbj" value="DBJ Comments" parent="0"/>
                <mxCell id="human" value="HUMAN USER" style="shape=actor;whiteSpace=wrap;html=1;verticalAlign=bottom;fontColor=#B85450;strokeColor=#B85450;fillColor=none;strokeWidth=3;" parent="dbj" vertex="1">
                    <mxGeometry x="1880" y="650" width="70" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#B85450;fontColor=#B85450;" parent="dbj" source="human" target="behavior" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-title" value="&lt;span style=&quot;font-weight: normal; color: #B85450;&quot;&gt;dbj:&lt;/span&gt; &lt;font style=&quot;font-size: 23px; color: #B85450;&quot;&gt;Harness App Arch&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-weight: normal; color: #B85450;&quot;&gt;giving the User an Agent-like experience,&lt;br&gt;and a local connection end point to the remote models&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#B85450;" vertex="1" parent="dbj">
                    <mxGeometry x="900" y="30" width="400" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-prompt" value="dbj: what you type in the terminal.&#xa;One text line (or pasted block) in the&#xa;claude.exe REPL. Nothing else." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B85450;strokeColor=#B85450;fillColor=none;dashed=1;spacingLeft=6;" vertex="1" parent="dbj">
                    <mxGeometry x="150" y="400" width="270" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-context" value="dbj: real files on my disk —&#xa;CLAUDE.md (user + project), the open&#xa;editor selection, git status, files read&#xa;so far. Re-sent whole, every turn." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B85450;strokeColor=#B85450;fillColor=none;dashed=1;spacingLeft=6;" vertex="1" parent="dbj">
                    <mxGeometry x="150" y="480" width="270" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-memory" value="dbj: also just files —&#xa;~/.claude/projects/&lt;slug&gt;/memory/*.md&#xa;indexed by MEMORY.md. Not model&#xa;memory; the harness pastes them in." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B85450;strokeColor=#B85450;fillColor=none;dashed=1;spacingLeft=6;" vertex="1" parent="dbj">
                    <mxGeometry x="150" y="575" width="270" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-l1" style="html=1;dashed=1;strokeColor=#B85450;endArrow=open;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="dbj" source="dbj-prompt" target="prompt">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-l2" style="html=1;dashed=1;strokeColor=#B85450;endArrow=open;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="dbj" source="dbj-context" target="context">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-l3" style="html=1;dashed=1;strokeColor=#B85450;endArrow=open;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="dbj" source="dbj-memory" target="memory">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-assembler-note" value="dbj: building the extended prompt payload for every call of the model; user prompt&amp;nbsp;+ CLAUDE.md file + memory/*.md +&lt;br&gt;conversation so far + last tool results + tool&lt;br&gt;schemas; all concatenated into one text blob.&lt;br&gt;&lt;br&gt;Why? Model is stateless, it needs a full conversation context on each remote call.&lt;br&gt;&lt;br&gt;Note: There is no &quot;offical name&quot; &quot;Context Assembly&quot;, it was ad-hoc invented by the creator of this diagram." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B85450;strokeColor=#B85450;fillColor=none;dashed=1;spacingLeft=6;" vertex="1" parent="dbj">
                    <mxGeometry x="360" y="670" width="270" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-assembler-link" style="html=1;dashed=1;strokeColor=#B85450;endArrow=open;endSize=6;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="dbj" source="dbj-assembler-note" target="assembler">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-results-note" value="dbj: tool results are just more text.&lt;br&gt;stdout, exit code, file content — appended&lt;br&gt;to the payload and sent back to the model&lt;br&gt;on the next call. The model does not &quot;see&quot;&lt;br&gt;the tool run results; it only reads what the harness&lt;br&gt;pasted in. The whole feedback texts." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B85450;strokeColor=#B85450;fillColor=none;dashed=1;spacingLeft=6;" vertex="1" parent="dbj">
                    <mxGeometry x="360" y="890" width="270" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-results-link" style="html=1;dashed=1;strokeColor=#B85450;endArrow=open;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="dbj" source="dbj-results-note">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="840" y="720" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="dbj-model-note" value="dbj: &quot;Claude Model&quot; is remote communication&#xa;end point. inside harness cli app&#xa;there is only a remote call to it&#xa;waiting for and collecting the textual reply" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#B85450;" vertex="1" parent="dbj">
                    <mxGeometry x="1400" y="215" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-model-link" style="html=1;dashed=1;strokeColor=#B85450;endArrow=open;endSize=6;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="dbj" source="dbj-model-note" target="endpoint">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-parser-note" value="dbj: the model does not call anything from itself. It just emits text.&lt;br&gt;Logi is: Part of that text may be a structured &lt;b&gt;tool_use &lt;/b&gt;block:&lt;br&gt;{&quot;name&quot;:&quot;Bash&quot;,&quot;input&quot;:{&quot;command&quot;:&quot;git status&quot;}}.&lt;br&gt;The parser reads it, looks the name up in the harness&lt;br&gt;dispatch table, and the harness runs the local code.&lt;br&gt;&lt;br&gt;The tool names and their parameter schemas were sent&lt;br&gt;to the model in the payload — that is how it knows&lt;br&gt;which names exist.&lt;br&gt;&lt;br&gt;Note the assumption: no tool_use block means &quot;done&quot;.&lt;br&gt;That is the harness deciding, not the model saying so." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B85450;strokeColor=#B85450;fillColor=none;dashed=1;spacingLeft=6;" vertex="1" parent="dbj">
                    <mxGeometry x="1550" y="410" width="330" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-parser-link" style="html=1;dashed=1;strokeColor=#B85450;endArrow=open;endSize=6;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.817;entryY=0.032;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="dbj" source="dbj-parser-note" target="parser">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1330" y="510"/>
                            <mxPoint x="1240" y="530"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="dbj-loop-note" value="dbj: nothing here is a tool. These are call sites — the harness&#xa;shells out to programs that already live on the desktop and&#xa;reads back their output. No tool is inside the app." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#B85450;" vertex="1" parent="dbj">
                    <mxGeometry x="790" y="945" width="440" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-call4" value="(call)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#B85450;" vertex="1" parent="dbj">
                    <mxGeometry x="1280" y="930" width="90" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-ext-bash" value="bash" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#B85450;strokeColor=#B85450;fillColor=none;" vertex="1" parent="dbj">
                    <mxGeometry x="830" y="1090" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-ext-nvim" value="nvim" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#B85450;strokeColor=#B85450;fillColor=none;" vertex="1" parent="dbj">
                    <mxGeometry x="980" y="1090" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-ext-chrome" value="chrome" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#B85450;strokeColor=#B85450;fillColor=none;" vertex="1" parent="dbj">
                    <mxGeometry x="1130" y="1090" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-x1" style="html=1;dashed=1;strokeColor=#B85450;endArrow=open;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="dbj" source="bash" target="dbj-ext-bash">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-x2" style="html=1;dashed=1;strokeColor=#B85450;endArrow=open;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="dbj" source="fileedit" target="dbj-ext-nvim">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-x3" style="html=1;dashed=1;strokeColor=#B85450;endArrow=open;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="dbj" source="browser" target="dbj-ext-chrome">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-ext-note" value="dbj: three ordinary desktop applications. They exist without the harness,&#xa;they are installed and updated separately, and they have no idea an agent&#xa;is driving them. The harness is only a caller." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#B85450;" vertex="1" parent="dbj">
                    <mxGeometry x="770" y="1160" width="640" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-caption-note" value="dbj: Claude Code CLI app is NOT the Harness.&#xa;It is an implementation of the Harness." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#B85450;" vertex="1" parent="dbj">
                    <mxGeometry x="924" y="1296" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="dbj-behavior-note" value="dbj: The app does not implement &quot;behave like an agent&quot;.&lt;br&gt;The model emits textutal reply. The harness feeds the results back. Run that loop enough times and it looks to the user like something is working on a task. That look (and feel) is all &quot;agent behavior&quot; means.&lt;br&gt;&lt;br&gt;&quot;Emergent&quot;&amp;nbsp; term, here it does the&amp;nbsp;marketing work — it dresses up a while-loop." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B85450;strokeColor=#B85450;fillColor=none;dashed=1;spacingLeft=6;" vertex="1" parent="dbj">
